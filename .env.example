# Discordサーバーで作ったWebhook URL（Repository Secretに登録する）
DISCORD_WEBHOOK_URL=

# GoogleサービスアカウントのJSON全文、またはそのBase64文字列
GOOGLE_SERVICE_ACCOUNT_JSON=

# 通知先Google CalendarのID
GOOGLE_CALENDAR_ID=

# RICOHへ送るUser-Agentの連絡先。GitHubのRepository Variableに登録する。
# 例: https://github.com/nekoromme/high-value-lottery-monitor
MONITOR_USER_AGENT_CONTACT=

